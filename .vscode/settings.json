{
  // Toolchain selection is managed by the Swift extension (Command Palette →
  // "Swift: Select Toolchain" → Xcode). Don't pin swift.path / DEVELOPER_DIR here —
  // it conflicts with the extension.

  // Code intelligence comes from SourceKit-LSP via buildServer.json (generated by
  // xcode-build-server — see docs/development.md), since there's no Package.swift.

  // The Xcode toolchain dir has no lldb-dap; the valid one ships under Developer/usr/bin.
  // Point the debugger at it so F5 (Run and Debug) works.
  "swift.debugger.path": "/Applications/Xcode.app/Contents/Developer/usr/bin/lldb-dap",

  // Don't let the extension auto-append launch configs — we debug the binary inside the
  // assembled .app bundle (see launch.json), not a bare executable.
  "swift.autoGenerateLaunchConfigurations": false,

  // Off on purpose: with no committed .swift-format, save-time formatting reflows against toolchain
  // defaults and rewrites untouched lines. See docs/decisions.md entry 26.
  "[swift]": {
    "editor.formatOnSave": false
  }
}
